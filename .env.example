# Copiá este archivo a .env y completá los valores reales.
# NUNCA subas el .env real a git (ya está en .gitignore).

# ---------- Obligatorias ----------
# Project Settings -> API en tu proyecto de Supabase.
SUPABASE_URL=https://tu-proyecto.supabase.co
# service_role key (NO la anon/public key). Solo se usa en el backend.
SUPABASE_SERVICE_ROLE_KEY=

# String largo y random para firmar las cookies de sesión del admin.
# Generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------- Opcionales ----------
PORT=3000

# Bucket de Supabase Storage donde se guardan las imágenes de productos.
SUPABASE_STORAGE_BUCKET=productos

# Usuario y contraseña que usa `npm run create-admin` para crear el primer
# usuario del panel (ver scripts/create-admin.js).
ADMIN_USER=
ADMIN_PASSWORD=

# Mercado Pago (Checkout Pro). Si se deja vacío, el sitio sigue funcionando
# solo con el checkout por WhatsApp.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública del sitio en producción (para armar links de retorno de MP y
# el webhook). En local se deduce sola del request.
PUBLIC_URL=
SITE_URL=https://ardsuplementos.com.ar

# SMTP para el mail de nuevos suscriptores del popup del home.
# Con Gmail: SMTP_USER=tu-cuenta@gmail.com, SMTP_PASS=contraseña de aplicación de 16 letras.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
