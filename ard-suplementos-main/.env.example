# Copiá este archivo a .env y completá los valores reales.
# NUNCA subas el .env real al repositorio (ya está en .gitignore).

# Puerto local (Vercel/hosting lo define solo en producción)
PORT=3000

# Panel de Supabase > Project Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Nombre del bucket de Storage donde se guardan las imágenes de productos
SUPABASE_STORAGE_BUCKET=productos

# String largo y random para firmar las cookies de sesión. Generalo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
